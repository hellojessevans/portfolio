---
import { getEntry } from "astro:content";

const intro = await getEntry("bio", "intro");
const { name, role, blurb, links = [] } = intro!.data;
---

<section class="mobile">
  <div class="card">
    <h1>{name}</h1>
    <p class="role">{role}</p>
    <p class="blurb">{blurb}</p>

    <p class="note">
      this little site is best with a real keyboard and a wider screen.
      come back on a desktop to look around properly — for now, here's where to find me:
    </p>

    {
      links.length > 0 && (
        <ul class="links">
          {links.map((l: { label: string; href: string }) => (
            <li>
              <a href={l.href} rel="noopener">
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .mobile {
    display: none;
    min-height: 100vh;
    background: var(--paper);
    padding: 2rem 1.25rem;
    align-items: center;
    justify-content: center;
  }

  @media (max-width: 899px), (pointer: coarse) {
    .mobile {
      display: flex;
    }
  }

  .card {
    max-width: 30rem;
    width: 100%;
  }

  h1 {
    font-family: var(--font-script);
    font-size: 3rem;
    font-weight: 400;
    line-height: 1;
    margin: 0 0 1rem;
    color: var(--ink);
  }

  .role {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    margin: 0 0 1.5rem;
    color: var(--ink-soft);
  }

  .blurb {
    font-family: var(--font-mono);
    font-size: 0.95rem;
    line-height: 1.65;
    margin: 0 0 1.5rem;
    color: var(--ink);
  }

  .note {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0 0 1.5rem;
  }

  .links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 2px;
  }

  .links a:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>
