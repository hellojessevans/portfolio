---
import { getEntry } from "astro:content";

interface Props {
  x: string;
  y: string;
  rot?: string;
  scale?: number;
}
const { x, y, rot = "0deg", scale = 1 } = Astro.props;

const music = await getEntry("music", "now-playing");
const { embedCode, width } = music!.data;

const style = `--x:${x};--y:${y};--rot:${rot};--scale:${scale};width:${width}`;
---

<div class="object record-embed" style={style}>
  <Fragment set:html={embedCode} />
</div>

<style>
  .record-embed {
    cursor: default;
  }
  .record-embed:hover {
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(var(--scale, 1));
  }
  .record-embed :global(iframe) {
    display: block;
    border: 0;
    width: 100%;
  }
</style>
