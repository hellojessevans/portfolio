---
import { getCollection } from "astro:content";

interface Props {
  x: string;
  y: string;
  rot?: string;
  scale?: number;
}
const { x, y, rot = "0deg", scale = 1 } = Astro.props;
const style = `--x:${x};--y:${y};--rot:${rot};--scale:${scale}`;

const studies = (await getCollection("caseStudies")).sort(
  (a, b) => a.data.order - b.data.order,
);

/* pre-render markdown bodies for the overlay */
const rendered = await Promise.all(
  studies.map(async (s) => {
    const { Content } = await s.render();
    return { slug: s.slug, data: s.data, Content };
  }),
);

/* ---- radial pill positions (build-time) ----
   Two concentric arcs with independent angle ranges so
   same-ring pills are far enough apart to avoid overlap.
   Inner ring (even indices): 5 pills, closer to folder.
   Outer ring (odd indices):  4 pills, further out, offset. */
const INNER_R = 310;
const OUTER_R = 480;
const COUNT = studies.length;
const innerCount = Math.ceil(COUNT / 2);  // 5
const outerCount = Math.floor(COUNT / 2); // 4

const positions: { x: number; y: number }[] = new Array(COUNT);

// Inner ring: arc 182°→340° (even indices)
const innerStart = 182;
const innerEnd = 340;
const innerStep = (innerEnd - innerStart) / (innerCount - 1);
for (let j = 0; j < innerCount; j++) {
  const angle = innerStart + j * innerStep;
  positions[j * 2] = {
    x: Math.round(Math.cos((angle * Math.PI) / 180) * INNER_R),
    y: Math.round(Math.sin((angle * Math.PI) / 180) * INNER_R),
  };
}

// Outer ring: arc 215°→305° (odd indices, pushed out to avoid inner overlap)
const outerStart = 215;
const outerEnd = 305;
const outerStep = (outerEnd - outerStart) / (outerCount - 1);
for (let j = 0; j < outerCount; j++) {
  const angle = outerStart + j * outerStep;
  positions[j * 2 + 1] = {
    x: Math.round(Math.cos((angle * Math.PI) / 180) * OUTER_R),
    y: Math.round(Math.sin((angle * Math.PI) / 180) * OUTER_R),
  };
}
---

<!-- backdrop (outside .object so position:fixed works) -------------------- -->
<div class="radial-backdrop" data-radial-backdrop></div>

<!-- folder + radial menu -------------------------------------------------- -->
<div class="object case-folder-wrap" style={style} data-folder-wrap data-label="Case Studies">
  <button
    class="case-folder"
    data-case-folder
    aria-label="Open case studies"
    aria-expanded="false"
  >
    <svg
      class="folder-svg"
      viewBox="0 0 160 140"
      fill="none"
      stroke="#b18597"
      stroke-width="2.4"
      stroke-linejoin="round"
      stroke-linecap="round"
      aria-hidden="true"
    >
      {/* back panel with tab */}
      <path
        d="M14 46 L14 36 Q14 30 20 30 L52 30 Q56 30 59 34 L65 46 L146 46 Q154 46 154 54 L154 126 Q154 134 146 134 L14 134 Q6 134 6 126 L6 54 Q6 46 14 46 Z"
        fill="#e3a9bd"
      />
      {/* papers that fan out on hover/open */}
      <rect class="paper paper-3" x="20" y="50" width="120" height="78" rx="3" fill="#fff0f0" stroke-width="1.6" />
      <rect class="paper paper-2" x="24" y="54" width="112" height="74" rx="3" fill="#ffe3e2" stroke-width="1.6" />
      <rect class="paper paper-1" x="28" y="58" width="104" height="70" rx="3" fill="#fff8f8" stroke-width="1.6" />
      {/* front panel */}
      <path
        class="folder-front"
        d="M10 64 L150 64 Q158 64 158 72 L158 128 Q158 136 150 136 L10 136 Q2 136 2 128 L2 72 Q2 64 10 64 Z"
        fill="#f9c4d2"
      />
      {/* detail lines on front */}
      <line x1="26" y1="82" x2="62" y2="82" stroke-width="1.4" stroke-opacity="0.4" />
      <line x1="26" y1="92" x2="50" y2="92" stroke-width="1.4" stroke-opacity="0.3" />
    </svg>
  </button>

  <div class="radial-ring" data-radial-ring>
    <span class="radial-heading">Case Studies</span>
    {studies.map((s, i) => (
      <button
        class:list={["radial-pill", { "radial-pill--disabled": s.data.comingSoon }]}
        style={`--i:${i}; --pill-x:${positions[i].x}px; --pill-y:${positions[i].y}px;`}
        data-cs-slug={s.data.comingSoon ? undefined : s.slug}
        type="button"
        disabled={s.data.comingSoon}
        tabindex="-1"
      >
        {s.data.company && <span class="pill-company">{s.data.company}</span>}
        <span class="pill-title">{s.data.title}</span>
        {s.data.comingSoon && <span class="pill-coming-soon">Coming soon</span>}
      </button>
    ))}
  </div>
</div>

<!-- full-screen overlay per case study ------------------------------------ -->
{rendered.filter(({ data }) => !data.comingSoon).map(({ slug, data, Content }, idx, arr) => {
  const prev = idx > 0 ? arr[idx - 1] : null;
  const next = idx < arr.length - 1 ? arr[idx + 1] : null;
  return (
    <dialog class="cs-overlay" id={`cs-${slug}`} data-cs-overlay>
      <div class="cs-overlay-scroll">
        <nav class="cs-overlay-nav">
          <button class="cs-back" type="button" data-cs-back>&larr; Case Studies</button>
          <button class="cs-overlay-close" type="button" aria-label="Close" data-cs-close>&times;</button>
        </nav>

        <header class="cs-overlay-header">
          <div class="cs-overlay-header-inner">
            <p class="cs-overlay-meta">
              {data.company}
              {data.company && data.year ? " · " : ""}
              {data.year}
              {(data.company || data.year) && data.role ? " · " : ""}
              {data.role}
            </p>
            <h2 class="cs-overlay-title">{data.title}</h2>
            <p class="cs-overlay-summary">{data.summary}</p>
          </div>
        </header>

        <div class="cs-overlay-body">
          <Content />
        </div>

        <nav class="cs-pagination">
          {prev ? (
            <button class="cs-pagination-btn" type="button" data-cs-nav={prev.slug}>
              <span class="cs-pagination-dir">&larr; Previous</span>
              <span class="cs-pagination-label">{prev.data.title}</span>
            </button>
          ) : <span />}
          {next ? (
            <button class="cs-pagination-btn cs-pagination-next" type="button" data-cs-nav={next.slug}>
              <span class="cs-pagination-dir">Next &rarr;</span>
              <span class="cs-pagination-label">{next.data.title}</span>
            </button>
          ) : <span />}
        </nav>
      </div>
    </dialog>
  );
})}

<!-- styles ---------------------------------------------------------------- -->
<style>
  /* ---- backdrop ---- */
  .radial-backdrop {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: rgba(20, 18, 14, 0.25);
    backdrop-filter: blur(2px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 300ms ease;
  }
  .radial-backdrop[data-open] {
    opacity: 1;
    pointer-events: auto;
  }

  /* ---- folder wrapper ---- */
  .case-folder-wrap {
    z-index: 1;
  }
  .case-folder-wrap:hover {
    /* neutralise global .object hover-scale */
    transform: translate(-50%, -50%) rotate(var(--rot, 0deg)) scale(var(--scale, 1));
  }
  /* counteract parent scale so label matches other objects */
  .case-folder-wrap[data-label]::after {
    transform: translate(-50%, 0) scale(calc(1 / var(--scale, 1)));
  }
  .case-folder-wrap:hover[data-label]::after {
    transform: translate(-50%, 6px) scale(calc(1 / var(--scale, 1)));
  }
  .case-folder-wrap[data-open] {
    z-index: 100;
  }

  /* ---- folder button ---- */
  .case-folder {
    position: relative;
    width: 200px;
    height: 160px;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    z-index: 2;
  }

  .folder-svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
    filter: drop-shadow(0 4px 6px rgba(80, 50, 62, 0.15));
    transition: filter 300ms ease;
    pointer-events: none;
  }
  .case-folder:hover .folder-svg,
  [data-open] .folder-svg {
    filter: drop-shadow(0 6px 10px rgba(80, 50, 62, 0.22));
  }

  .paper {
    transform-box: fill-box;
    transform-origin: center bottom;
    transition: transform 320ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  .case-folder:hover .paper-3,
  [data-open] .paper-3 {
    transform: translateY(-22px) rotate(-4deg);
  }
  .case-folder:hover .paper-2,
  [data-open] .paper-2 {
    transform: translateY(-16px) rotate(2.5deg);
  }
  .case-folder:hover .paper-1,
  [data-open] .paper-1 {
    transform: translateY(-10px) rotate(-1.5deg);
  }


  /* ---- radial ring ---- */
  .radial-ring {
    position: absolute;
    left: 100px;  /* center of 200px folder */
    top: 80px;    /* center of 160px folder */
    z-index: 1;
    /* undo parent .object rotation and scale so pills are axis-aligned,
       then shift left because folder sits at 70% from viewport left */
    transform: rotate(calc(-1 * var(--rot, 0deg))) scale(calc(1 / var(--scale, 1))) translateX(-40px);
    pointer-events: none;
  }
  [data-open] .radial-ring {
    pointer-events: auto;
  }

  .radial-heading {
    display: none;
  }

  /* ---- radial pills (push-btn style with chin, no bottom shadow) ---- */
  .radial-pill {
    position: absolute;
    left: 0;
    top: 0;
    /* closed state: centered at origin, invisible */
    transform: translate(-50%, -50%) scale(0);
    opacity: 0;
    /* close animation: reverse stagger (last pill first) */
    --close-delay: calc((8 - var(--i, 0)) * 30ms);
    transition:
      transform 280ms ease-in var(--close-delay),
      opacity 180ms ease var(--close-delay);

    /* push-btn visual style */
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 0.55em 1em;
    background: var(--pink-bg);
    border: 2px solid var(--pink-border);
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
    font-family: var(--font-mono);
    color: var(--pink-ink);
    text-align: center;
    transform-style: preserve-3d;
  }
  /* 3D chin (no bottom shadow, just the chin face + border outline) */
  .radial-pill::before {
    position: absolute;
    content: "";
    inset: 0;
    background: var(--pink-face);
    border-radius: inherit;
    box-shadow: 0 0 0 2px var(--pink-border);
    transform: translate3d(0, 0.5em, -1em);
    transition: none;
  }

  /* open state: spring-out to computed position */
  [data-open] .radial-pill {
    --open-delay: calc(var(--i, 0) * 55ms);
    transform: translate(-50%, -50%) translate(var(--pill-x), var(--pill-y)) scale(1);
    opacity: 1;
    transition:
      transform 420ms cubic-bezier(0.34, 1.56, 0.64, 1) var(--open-delay),
      opacity 220ms ease var(--open-delay);
  }
  /* after fan-out settles, use fast transitions for hover in/out */
  [data-open].settled .radial-pill {
    transition: transform 150ms var(--ease-push), background 150ms var(--ease-push);
  }
  [data-open] .radial-pill::before {
    transition: transform 150ms var(--ease-push);
  }

  /* hover: push button DOWN into chin (150ms to match chin timing) */
  .radial-pill:hover {
    background: var(--pink-bg-hover);
    transform: translate(-50%, -50%) translate(var(--pill-x), var(--pill-y)) scale(1) translateY(0.2em);
    transition: transform 150ms var(--ease-push), background 150ms var(--ease-push);
  }
  .radial-pill:hover::before {
    transform: translate3d(0, 0.3em, -1em);
  }
  /* active: fully pressed */
  .radial-pill:active {
    background: var(--pink-bg-hover);
    transform: translate(-50%, -50%) translate(var(--pill-x), var(--pill-y)) scale(1) translateY(0.5em);
    transition: transform 150ms var(--ease-push), background 150ms var(--ease-push);
  }
  .radial-pill:active::before {
    transform: translate3d(0, 0, -1em);
  }
  .radial-pill:focus-visible {
    outline: 2px solid var(--pink-border);
    outline-offset: 3px;
  }

  .pill-company {
    font-size: 0.55rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pink-border);
    line-height: 1;
  }

  .pill-title {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    line-height: 1.2;
    color: var(--pink-ink);
  }

  .pill-coming-soon {
    font-size: 0.55rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--pink-border);
    line-height: 1;
    margin-top: 3px;
  }

  /* disabled / coming-soon pill — flat (no chin) */
  .radial-pill--disabled {
    opacity: 0;
    cursor: default;
    background: var(--pink-bg);
    border-color: #d4c4c9;
  }
  .radial-pill--disabled::before {
    display: none;
  }
  [data-open] .radial-pill--disabled {
    opacity: 0.85;
  }
  .radial-pill--disabled:hover {
    background: var(--pink-bg);
    transform: translate(-50%, -50%) translate(var(--pill-x), var(--pill-y)) scale(1);
    transition: none;
  }
  .radial-pill--disabled .pill-company,
  .radial-pill--disabled .pill-title {
    color: var(--pink-ink);
    opacity: 0.5;
  }
  .radial-pill--disabled .pill-coming-soon {
    opacity: 0.5;
  }

  /* ---- full-screen overlay ---- */
  .cs-overlay {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    border: none;
    padding: 0;
    margin: 0;
    background: var(--paper-warm);
    overflow: hidden;
  }
  .cs-overlay::backdrop {
    background: rgba(20, 18, 14, 0.4);
  }
  .cs-overlay[open] {
    animation: overlayIn 320ms ease-out;
  }
  @keyframes overlayIn {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .cs-overlay-scroll {
    width: 100%;
    height: 100%;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .cs-overlay-nav {
    position: sticky;
    top: 0;
    z-index: 10;
    padding: 1.25rem 2.5rem;
    background: var(--paper-warm);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .cs-back {
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-soft);
    padding: 0.25rem 0;
    transition: color 150ms;
  }
  .cs-back:hover {
    color: var(--ink);
  }
  .cs-back:focus:not(:focus-visible) {
    outline: none;
  }

  .cs-overlay-close {
    background: none;
    border: none;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
    color: var(--ink-soft);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    transition: color 150ms, background 150ms;
  }
  .cs-overlay-close:hover {
    color: var(--ink);
    background: rgba(0, 0, 0, 0.05);
  }

  .cs-overlay-header {
    padding: 3rem 2.5rem 2.5rem;
    display: flex;
    justify-content: center;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
  }

  .cs-overlay-header-inner {
    width: 100%;
    max-width: 720px;
  }

  .cs-overlay-meta {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--pink-border);
    margin: 0 0 0.75rem;
  }

  .cs-overlay-title {
    font-family: var(--font-serif);
    font-size: 2.25rem;
    font-weight: 600;
    line-height: 1.2;
    margin: 0 0 0.75rem;
    color: var(--ink);
  }

  .cs-overlay-summary {
    font-family: var(--font-mono);
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-soft);
    margin: 0;
  }

  .cs-overlay-body {
    max-width: 720px;
    margin: 0 auto;
    padding: 2.5rem 2.5rem 5rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--ink);
  }
  .cs-overlay-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 3rem 0 1rem;
    color: var(--ink);
  }
  .cs-overlay-body :global(h2:first-child) {
    margin-top: 0;
  }
  .cs-overlay-body :global(p) {
    margin: 0 0 1.25rem;
  }
  .cs-overlay-body :global(ul),
  .cs-overlay-body :global(ol) {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }
  .cs-overlay-body :global(li) {
    margin-bottom: 0.4rem;
  }
  .cs-overlay-body :global(strong) {
    font-weight: 700;
  }
  .cs-overlay-body :global(a) {
    color: var(--accent);
  }
  .cs-overlay-body :global(img) {
    display: block;
    max-width: 100%;
    border-radius: 8px;
    margin: 2rem 0;
    cursor: zoom-in;
  }

  /* lightbox zoom (global because element is created dynamically) */
  :global(.cs-lightbox) {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    border: none;
    padding: 0;
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    cursor: zoom-out;
    animation: lbFadeIn 200ms ease;
    transition: opacity 150ms ease;
  }
  :global(.cs-lightbox::backdrop) {
    background: transparent;
  }
  @keyframes lbFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  :global(.cs-lightbox img) {
    max-width: 92vw;
    max-height: 92vh;
    object-fit: contain;
    border-radius: 4px;
  }

  /* ---- prev / next pagination ---- */
  .cs-pagination {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2.5rem 4rem;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1.5rem;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
    padding-top: 2rem;
  }
  .cs-pagination-btn {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.3rem;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-mono);
    text-align: left;
    padding: 0.25rem 0;
    transition: color 150ms;
  }
  .cs-pagination-btn:hover {
    color: var(--ink);
  }
  .cs-pagination-next {
    text-align: right;
    align-items: flex-end;
    margin-left: auto;
  }
  .cs-pagination-dir {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
    transition: color 150ms;
  }
  .cs-pagination-btn:hover .cs-pagination-dir {
    color: var(--ink);
  }
  .cs-pagination-label {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--ink-soft);
    line-height: 1.3;
    transition: color 150ms;
  }
  .cs-pagination-btn:hover .cs-pagination-label {
    color: var(--ink);
  }

  /* ---- mobile: tap-to-open overlay list ---- */
  @media (max-width: 899px), (pointer: coarse) {
    .case-folder-wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      z-index: auto !important;
    }
    .case-folder {
      width: 200px;
      height: 160px;
      transform: rotate(-2deg);
    }

    .case-folder-wrap[data-label]::after {
      display: none;
    }

    .radial-heading {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      white-space: nowrap;
      color: var(--ink-soft);
      background: var(--paper-warm);
      padding: 4px 12px;
      border-radius: 4px;
      opacity: 0;
      transition: opacity 250ms ease;
    }
    [data-open] .radial-heading {
      opacity: 1;
    }

    /* pills as centered overlay on tap */
    .radial-ring {
      position: fixed;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      width: 90vw;
      max-width: 20rem;
      max-height: 80vh;
      overflow-y: auto;
      padding: 1rem;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 250ms ease;
    }
    [data-open] .radial-ring {
      opacity: 1;
      /* keep pointer-events: none on the container so taps outside pills
         fall through to the backdrop; individual pills get auto below */
    }

    .radial-pill {
      position: relative;
      left: auto;
      top: auto;
      transform: none !important;
      opacity: 0;
      pointer-events: none;
      width: 100%;
      white-space: normal;
      transition: none !important;
    }
    [data-open] .radial-pill {
      opacity: 1;
      pointer-events: auto;
      transform: none !important;
    }
    .radial-pill:hover {
      transform: none !important;
    }
    .radial-pill::before {
      transform: translate3d(0, 0.4em, -1em);
    }
    .radial-pill:hover::before {
      transform: translate3d(0, 0.2em, -1em);
    }
    .radial-pill:active::before {
      transform: translate3d(0, 0, -1em);
    }
    [data-open] .radial-pill--disabled {
      opacity: 0.85;
    }

    /* overlay responsive padding */
    .cs-overlay-nav { padding: 1rem 1.25rem; }
    .cs-overlay-header { padding: 2rem 1.25rem 1.5rem; }
    .cs-overlay-body { padding: 1.5rem 1.25rem 2rem; }
    .cs-overlay-title { font-size: 1.8rem; }
    .cs-pagination { padding: 0 1.25rem 3rem; }
  }
</style>

<!-- script ---------------------------------------------------------------- -->
<script>
  const folder = document.querySelector<HTMLButtonElement>("[data-case-folder]");
  const wrap = document.querySelector<HTMLDivElement>("[data-folder-wrap]");
  const backdrop = document.querySelector<HTMLDivElement>("[data-radial-backdrop]");
  const ring = document.querySelector<HTMLDivElement>("[data-radial-ring]");
  const pills = document.querySelectorAll<HTMLButtonElement>(".radial-pill");
  let isOpen = false;

  let settledTimer: ReturnType<typeof setTimeout> | null = null;

  function openMenu() {
    if (isOpen) return;
    isOpen = true;
    wrap?.setAttribute("data-open", "");
    backdrop?.setAttribute("data-open", "");
    folder?.setAttribute("aria-expanded", "true");
    pills.forEach((p) => {
      if (!p.disabled) p.setAttribute("tabindex", "0");
    });
    settledTimer = setTimeout(() => wrap?.classList.add("settled"), 600);
  }

  function closeMenu() {
    if (!isOpen) return;
    isOpen = false;
    if (settledTimer) { clearTimeout(settledTimer); settledTimer = null; }
    wrap?.classList.remove("settled");
    wrap?.removeAttribute("data-open");
    backdrop?.removeAttribute("data-open");
    folder?.setAttribute("aria-expanded", "false");
    pills.forEach((p) => p.setAttribute("tabindex", "-1"));
  }

  /* folder click toggles menu */
  folder?.addEventListener("click", () => {
    isOpen ? closeMenu() : openMenu();
  });

  /* backdrop click closes */
  backdrop?.addEventListener("click", closeMenu);

  /* escape key closes */
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && isOpen) {
      e.preventDefault();
      closeMenu();
    }
  });

  /* pill click → close menu, open overlay */
  pills.forEach((pill) => {
    pill.addEventListener("click", () => {
      const slug = pill.dataset.csSlug;
      if (!slug) return;
      closeMenu();
      requestAnimationFrame(() => {
        const overlay = document.getElementById(`cs-${slug}`) as HTMLDialogElement | null;
        overlay?.showModal();
      });
    });
  });

  /* arrow key navigation among pills */
  ring?.addEventListener("keydown", (e) => {
    if (!isOpen) return;
    const activePills = Array.from(pills).filter((p) => !p.disabled);
    const current = document.activeElement as HTMLButtonElement;
    const idx = activePills.indexOf(current);
    if (idx === -1) return;

    if (e.key === "ArrowRight" || e.key === "ArrowDown") {
      e.preventDefault();
      activePills[(idx + 1) % activePills.length]?.focus();
    } else if (e.key === "ArrowLeft" || e.key === "ArrowUp") {
      e.preventDefault();
      activePills[(idx - 1 + activePills.length) % activePills.length]?.focus();
    }
  });

  /* overlay back button → close overlay, re-open radial menu */
  document.querySelectorAll<HTMLButtonElement>("[data-cs-back]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const overlay = btn.closest("dialog") as HTMLDialogElement | null;
      overlay?.close();
      requestAnimationFrame(() => openMenu());
    });
  });

  /* overlay close button → close overlay, back to main page */
  document.querySelectorAll<HTMLButtonElement>("[data-cs-close]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const overlay = btn.closest("dialog") as HTMLDialogElement | null;
      overlay?.close();
    });
  });

  /* prev/next pagination → close current, open target */
  document.querySelectorAll<HTMLButtonElement>("[data-cs-nav]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const targetSlug = btn.dataset.csNav;
      if (!targetSlug) return;
      const currentOverlay = btn.closest("dialog") as HTMLDialogElement | null;
      currentOverlay?.close();
      requestAnimationFrame(() => {
        const target = document.getElementById(`cs-${targetSlug}`) as HTMLDialogElement | null;
        if (target) {
          target.showModal();
          /* scroll to top of new study */
          target.querySelector(".cs-overlay-scroll")?.scrollTo(0, 0);
        }
      });
    });
  });

  /* lightbox: click image to zoom, click again to close */
  function closeLightbox(lb: HTMLDialogElement) {
    lb.style.opacity = "0";
    setTimeout(() => { lb.close(); lb.remove(); }, 150);
  }

  document.querySelectorAll(".cs-overlay-body img").forEach((img) => {
    img.addEventListener("click", () => {
      const lb = document.createElement("dialog");
      lb.className = "cs-lightbox";
      const clone = document.createElement("img");
      clone.src = (img as HTMLImageElement).src;
      clone.alt = (img as HTMLImageElement).alt;
      lb.appendChild(clone);
      lb.addEventListener("click", () => closeLightbox(lb));
      lb.addEventListener("cancel", (e) => { e.preventDefault(); closeLightbox(lb); });
      document.body.appendChild(lb);
      lb.showModal();
    });
  });
</script>
